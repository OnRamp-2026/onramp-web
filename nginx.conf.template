# ${API_UPSTREAM} 만 envsubst로 치환된다(nginx:alpine 기본 동작). $uri·$host 등 nginx 변수는 보존.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # k8s probe
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # 백엔드 API 프록시 (same-origin → CORS 0, 세션 쿠키 정상)
    location /v1/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # 챗(LLM)·전사 폴링 대비
        proxy_send_timeout 120s;
    }

    location /auth/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 해시된 정적 에셋 — 파일명에 콘텐츠 해시 → 불변, 장기 캐시
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA — 정적 파일 우선, 없으면 index.html (클라이언트 라우팅)
    # index.html은 항상 재검증해야 새 번들 해시를 픽업한다(stale 화면 방지).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
