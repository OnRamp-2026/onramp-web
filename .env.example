# 백엔드 API base URL (비우면 Vite proxy의 /v1 사용)
VITE_API_BASE_URL=
# STT/보고서 API 실연동. UI 시연만 할 때 true.
VITE_USE_MOCK=false
# scripts에서 발급한 개발용 onramp-api JWT
VITE_DEV_AUTH_TOKEN=
# STT workflow polling
VITE_STT_POLL_INTERVAL_MS=2000
VITE_STT_POLL_TIMEOUT_MS=1800000
# 로그인: true=mock IdP 시연 / false=백엔드 OIDC 클라이언트(/auth/*, Keycloak 위임) 실 연동
VITE_AUTH_MOCK=true
